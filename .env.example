# --- Telegram Userbot (https://my.telegram.org) ---
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
TG_PHONE=+79991234567
TG_SESSION_NAME=userbot

# --- Telegram Bot (от @BotFather) ---
BOT_TOKEN=123456789:AA...your_bot_token

# Список каналов для мониторинга через запятую (username или -100... id)
TG_CHANNELS=@example_channel,@another_channel

# --- LLM ---
# Провайдер: stub | openai | ollama
#   stub   — заглушка без API, regex-эвристики (для теста пайплайна)
#   openai — реальный OpenAI API
#   ollama — локальная модель через Ollama
LLM_PROVIDER=stub

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (локальный)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- PostgreSQL ---
# Можно задать одной строкой DATABASE_URL=postgresql://user:pass@host:5432/db
# либо отдельные пять POSTGRES_* переменных (используются compose-сервисом):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tg_parser
POSTGRES_USER=tg_parser
POSTGRES_PASSWORD=change_me_strong_password

# --- Image (для prod-compose, сюда подставит CI) ---
IMAGE=ghcr.io/OWNER/REPO:latest

# --- Прочее ---
LOG_LEVEL=INFO
