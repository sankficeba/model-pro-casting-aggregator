# --- Telegram Userbot (https://my.telegram.org) ---
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
TG_PHONE=+79991234567
TG_SESSION_NAME=userbot

# --- Telegram Bot (от @BotFather) ---
BOT_TOKEN=123456789:AA...your_bot_token

# Список каналов для мониторинга через запятую (username или -100... id)
TG_CHANNELS=@example_channel,@another_channel

# --- LLM ---
# Провайдер: openai | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (локальный)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Прочее ---
LOG_LEVEL=INFO
FILTERS_FILE=/app/data/filters.json
